generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ENUMS (Format multi-lignes obligatoire pour Prisma)


enum enum_statut_etudiant {
  Actif
  Diplome
  Abandon
}

enum enum_statut_employe {
  Actif
  Inactif
  Conge
}

enum enum_statut_workflow {
  Actif
  Inactif
}

enum enum_statut_etape {
  En_Attente
  En_Cours
  Validee
  Rejetee
}

enum enum_statut_demande {
  Brouillon
  Soumise
  En_Traitement
  Validee
  Rejetee
  Cloturee
}

enum enum_priorite {
  Basse
  Normale
  Haute
  Urgente
}

enum enum_categorie_reclamation {
  Note
  AMO
  Bourse
  Email
  Autre
  CertificatMedical
}

enum enum_statut_reclamation {
  Soumise
  Recue
  Transmise
  Acceptee
  Rejetee
  Cloturee
}

enum enum_statut_certificat {
  En_Attente
  Valide
  Rejete
}

enum enum_statut_verification {
  Demandee
  Acceptee
  Rejetee
  Planifiee
  Consultee
  Cloturee
}

enum enum_type_demande_rh {
  Attestation_Travail
  Attestation_Salaire
  Conge_Normal
  Conge_Exceptionnel
  Conge_Maladie
  Heure_Supplementaire
  Mission
  Autre
}

enum enum_statut_club {
  Actif
  Inactif
  Suspendu
}

enum enum_statut_president {
  Actif
  Expire
}

enum enum_type_demande_club {
  Evenement
  Salle
  Materiel
  Budget
  Communication
  Sponsoring
}

enum enum_statut_demande_club {
  Soumise
  En_Revue
  Approuvee
  Rejetee
}

enum enum_type_salle {
  Amphitheatre
  Salle_Cours
  Laboratoire
  Salle_Reunion
}

enum enum_statut_salle {
  Disponible
  Occupee
  Maintenance
}

enum enum_statut_session {
  Planifiee
  En_Cours
  Terminee
  Annulee
}

enum enum_statut_presence {
  Present
  Retard
  Absent
  Excuse
}

enum enum_methode_identification {
  RFID
  QR_Code
  Reconnaissance_Faciale
}

enum enum_statut_reservation {
  Demandee
  Approuvee
  Rejetee
  Annulee
}

enum enum_type_alerte {
  Conflit_Planning
  Salle_Fantome
  Surcharge
  Anomalie
}

enum enum_statut_alerte {
  Nouvelle
  En_Traitement
  Resolue
  Ignoree
}

enum enum_statut_conversation {
  Ouverte
  Fermee
}

enum enum_type_notification {
  Demande
  Document
  Calendrier
  Systeme
  Info
  Succes
  Alerte
  Urgent
}

enum enum_priorite_notification {
  Info
  Warning
  Urgent
}

enum enum_statut_conversation_ia {
  Active
  Cloturee
}

enum enum_role_message_ia {
  User
  Assistant
  System
}

enum enum_type_parametre {
  String
  Integer
  Boolean
  JSON
}


// CORE


model Role {
  id_role      String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom_role     String           @unique @db.VarChar(100)
  description  String?          @db.Text
  created_at   DateTime         @default(now()) @db.Timestamptz(6)
  updated_at   DateTime         @default(now()) @db.Timestamptz(6)
  permissions  RolePermission[]
  utilisateurs Utilisateur[]

  @@map("role")
}

model Permission {
  id_permission String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom           String           @db.VarChar(150)
  module        String           @db.VarChar(100)
  description   String?          @db.Text
  roles         RolePermission[]

  @@unique([nom, module])
  @@unique([nom], map: "uq_permission_nom") // ✅ Empêche la suppression de la contrainte existante
  @@map("permission")
}

model RolePermission {
  id_role       String     @db.Uuid
  id_permission String     @db.Uuid
  role          Role       @relation(fields: [id_role], references: [id_role], onDelete: Cascade)
  permission    Permission @relation(fields: [id_permission], references: [id_permission], onDelete: Cascade)

  @@id([id_role, id_permission])
  @@map("role_permission")
}

model Utilisateur {
  id_utilisateur     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_role            String    @db.Uuid
  nom                String?   @db.VarChar(100)      // ✅ Optionnel pour matcher la DB
  prenom             String?   @db.VarChar(100)      // ✅ Optionnel pour matcher la DB
  email              String    @unique @db.VarChar(255)
  mot_de_passe       String?   @db.VarChar(255)
  telephone          String?   @db.VarChar(30)
  photo              Bytes?
  photo_type         String?   @db.VarChar(100)
  actif              Boolean   @default(true)
  date_creation      DateTime  @default(now()) @db.Timestamptz(6)
  derniere_connexion DateTime? @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @db.Timestamptz(6)

  notif_email      Boolean @default(true)
  notif_demandes   Boolean @default(true)
  notif_documents  Boolean @default(true)
  notif_calendrier Boolean @default(false)

  role                      Role                      @relation(fields: [id_role], references: [id_role], onDelete: Restrict)
  etudiant                  Etudiant?
  employe                   Employe?
  audit_logs                AuditLog[]
  reservations              ReservationSalle[]
  conversations_participees ConversationParticipant[]
  messages_envoyes          Message[]
  notifications             Notification[]
  reset_tokens              PasswordResetToken[]

  @@index([id_role], map: "idx_utilisateur_role")
  @@map("utilisateur")
}

model PasswordResetToken {
  id             Int         @id @default(autoincrement())
  id_utilisateur String      @db.Uuid
  otp            String      @db.VarChar(255)
  expires_at     DateTime    @db.Timestamp
  used           Boolean     @default(false)
  created_at     DateTime    @default(now()) @db.Timestamp
  utilisateur    Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)

  @@map("password_reset_tokens")
}


// ACADÉMIQUE & EMPLOYÉS


model Filiere {
  id_filiere String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom        String         @db.VarChar(150)
  code       String?        @db.VarChar(10)
  etudiants  Etudiant[]
  sessions   SessionSalle[] // ✅ AJOUTÉ pour conserver la relation existante

  @@map("filiere")
}

model Etudiant {
  id_etudiant      String               @id @db.Uuid
  id_filiere       String               @db.Uuid
  cne              String               @unique @db.VarChar(20)
  cin              String               @unique @db.VarChar(20)
  code_apogee      String?              @unique @db.VarChar(20)
  code_massar      String?              @db.VarChar(20)
  niveau           String?              @db.VarChar(50)
  email_academique String?              @unique @db.VarChar(255)
  date_inscription DateTime             @default(now()) @db.Date
  statut           enum_statut_etudiant @default(Actif)

  utilisateur         Utilisateur         @relation(fields: [id_etudiant], references: [id_utilisateur], onDelete: Cascade)
  filiere             Filiere             @relation(fields: [id_filiere], references: [id_filiere], onDelete: Restrict)
  demandes            Demande[]
  reclamations        Reclamation[]
  certificats         CertificatMedical[]
  verifications       VerificationExam[]
  presences           PresenceEtudiant[]
  presidents_club     PresidentClub[]
  conversations_ia    ConversationIA[]
  documents_officiels DocumentOfficiel[]
  conversations       Conversation[]

  @@index([id_filiere], map: "idx_etudiant_filiere")
  @@index([statut], map: "idx_etudiant_statut")
  @@map("etudiant")
}

model Employe {
  id_employe         String              @id @db.Uuid
  matricule          String              @unique @db.VarChar(30)
  fonction           String              @db.VarChar(150)
  departement        String?             @db.VarChar(150)
  date_embauche      DateTime            @db.Date
  statut             enum_statut_employe @default(Actif)
  grade              String?             @db.VarChar(50)
  id_rh_gestionnaire String?             @db.Uuid

  utilisateur         Utilisateur     @relation(fields: [id_employe], references: [id_utilisateur], onDelete: Cascade)
  rh_gestionnaire     RhResponsable?  @relation("EmployeRhGestionnaire", fields: [id_rh_gestionnaire], references: [id_rh], onDelete: SetNull)
  professeur          Professeur?
  scolarite_staff     ScolariteStaff?
  rh_responsable_self RhResponsable?  @relation("RhEmploye")
  demandes_rh         DemandeRh[]

  @@index([statut], map: "idx_employe_statut")
  @@index([id_rh_gestionnaire], map: "idx_employe_rh_gestionnaire")
  @@map("employe")
}

model Professeur {
  id_professeur        String  @id @db.Uuid
  specialite           String? @db.VarChar(150)
  grade_academique     String? @db.VarChar(100)
  heures_hebdomadaires Int?    @db.SmallInt

  employe          Employe            @relation(fields: [id_professeur], references: [id_employe], onDelete: Cascade)
  cours_professeur CoursProfesseur[]
  verifications    VerificationExam[]
  sessions         SessionSalle[]
  reclamations     Reclamation[]

  @@map("professeur")
}

model ScolariteStaff {
  id_scolarite String  @id @db.Uuid
  service      String? @db.VarChar(150)
  poste        String? @db.VarChar(150)
  bureau       String? @db.VarChar(50)

  employe                  Employe             @relation(fields: [id_scolarite], references: [id_employe], onDelete: Cascade)
  demandes_traitees        Demande[]
  reclamations_traitees    Reclamation[]
  certificats_valides      CertificatMedical[]
  verifications_transmises VerificationExam[]
  presidents_designes      PresidentClub[]
  demandes_club_traitees   DemandeClub[]

  @@map("scolarite_staff")
}

model RhResponsable {
  id_rh           String  @id @db.Uuid
  service         String? @db.VarChar(150)
  poste           String? @db.VarChar(150)
  niveau_autorite Int     @default(1) @db.SmallInt
  bureau          String? @db.VarChar(50)

  employe           Employe     @relation("RhEmploye", fields: [id_rh], references: [id_employe], onDelete: Cascade)
  employes_geres    Employe[]   @relation("EmployeRhGestionnaire")
  demandes_traitees DemandeRh[]

  @@map("rh_responsable")
}

model Cours {
  id_cours    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String @unique @db.VarChar(30)
  nom         String @db.VarChar(200)
  credits     Int    @db.SmallInt
  coefficient Int    @db.SmallInt

  cours_professeur CoursProfesseur[]
  reclamations     Reclamation[]
  sessions         SessionSalle[]

  @@map("cours")
}

model CoursProfesseur {
  id_cours      String     @db.Uuid
  id_professeur String     @db.Uuid
  cours         Cours      @relation(fields: [id_cours], references: [id_cours], onDelete: Cascade)
  professeur    Professeur @relation(fields: [id_professeur], references: [id_professeur], onDelete: Cascade)

  @@id([id_cours, id_professeur])
  @@map("cours_professeur")
}


// WORKFLOW & DEMANDES


model Workflow {
  id_workflow   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom           String               @db.VarChar(150)
  description   String?              @db.Text
  statut        enum_statut_workflow @default(Actif)
  date_creation DateTime             @default(now()) @db.Timestamptz(6)

  types_demande TypeDemande[]
  etapes        EtapeWorkflow[]
  demandes      Demande[]

  @@map("workflow")
}

model TypeDemande {
  id_type          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libelle          String  @db.VarChar(150)
  code             String  @unique @db.VarChar(30)
  description      String? @db.Text
  id_workflow      String? @db.Uuid
  delai_traitement Int?
  pieces_requises  Json?   @db.JsonB

  workflow Workflow? @relation(fields: [id_workflow], references: [id_workflow], onDelete: SetNull)
  demandes Demande[]

  @@map("type_demande")
}

model EtapeWorkflow {
  id_etape         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_workflow      String            @db.Uuid
  ordre            Int               @db.SmallInt
  nom              String            @db.VarChar(150)
  role_responsable String?           @db.VarChar(100)
  statut           enum_statut_etape @default(En_Attente)
  date_debut       DateTime?         @db.Timestamptz(6)
  date_fin         DateTime?         @db.Timestamptz(6)
  commentaires     String?           @db.Text

  workflow Workflow @relation(fields: [id_workflow], references: [id_workflow], onDelete: Cascade)

  @@unique([id_workflow, ordre])
  @@index([id_workflow], map: "idx_etape_workflow_workflow")
  @@map("etape_workflow")
}

model Demande {
  id_demande    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero        String              @unique @db.VarChar(50)
  id_etudiant   String              @db.Uuid
  id_type       String              @db.Uuid
  id_workflow   String              @db.Uuid
  id_traite_par String?             @db.Uuid
  objet         String              @db.VarChar(255)
  description   String?             @db.Text
  date_creation DateTime            @default(now()) @db.Timestamptz(6)
  statut        enum_statut_demande @default(Brouillon)
  priorite      enum_priorite       @default(Normale)
  commentaires  String?             @db.Text

  etudiant            Etudiant           @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)
  type_demande        TypeDemande        @relation(fields: [id_type], references: [id_type], onDelete: Restrict)
  workflow            Workflow           @relation(fields: [id_workflow], references: [id_workflow], onDelete: Restrict)
  traite_par          ScolariteStaff?    @relation(fields: [id_traite_par], references: [id_scolarite], onDelete: SetNull)
  documents           Document[]
  documents_officiels DocumentOfficiel[]

  @@index([id_etudiant], map: "idx_demande_etudiant")
  @@index([id_type], map: "idx_demande_type")
  @@index([statut], map: "idx_demande_statut")
  @@index([id_traite_par], map: "idx_demande_traite_par")
  @@map("demande")
}


// RÉCLAMATIONS & DOCUMENTS


model TypeReclamation {
  id_type                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libelle                String                     @db.VarChar(150)
  code                   String                     @unique @db.VarChar(30)
  categorie              enum_categorie_reclamation
  delai_limite           Int?
  quota_max              Int?
  conditions_eligibilite Json?                      @db.JsonB

  reclamations Reclamation[]

  @@map("type_reclamation")
}

model Reclamation {
  id_reclamation        String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_etudiant           String                  @db.Uuid
  id_type               String                  @db.Uuid
  id_cours              String?                 @db.Uuid
  id_traite_par         String?                 @db.Uuid
  id_professeur         String?                 @db.Uuid
  nom_professeur_manuel String?                 @db.VarChar(150)
  id_certificat         String?                 @db.Uuid
  objet                 String                  @db.VarChar(255)
  description           String?                 @db.Text
  date_soumission       DateTime                @default(now()) @db.Timestamptz(6)
  statut                enum_statut_reclamation @default(Soumise)
  priorite              enum_priorite           @default(Normale)
  nombre_traitement     Int                     @default(0)
  reponse   String?   @db.Text

  etudiant         Etudiant           @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)
  type_reclamation TypeReclamation    @relation(fields: [id_type], references: [id_type], onDelete: Restrict)
  cours            Cours?             @relation(fields: [id_cours], references: [id_cours], onDelete: SetNull)
  professeur       Professeur?        @relation(fields: [id_professeur], references: [id_professeur], onDelete: SetNull)
  certificat       CertificatMedical? @relation(fields: [id_certificat], references: [id_certificat], onDelete: SetNull)
  traite_par       ScolariteStaff?    @relation(fields: [id_traite_par], references: [id_scolarite], onDelete: SetNull)
  documents        Document[]

  @@index([id_etudiant], map: "idx_reclamation_etudiant")
  @@index([statut], map: "idx_reclamation_statut")
  @@index([id_traite_par], map: "idx_reclamation_traite_par")
  @@map("reclamation")
}

model Document {
  id_document         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_demande          String?   @db.Uuid
  id_reclamation      String?   @db.Uuid
  id_message          String?   @db.Uuid
  nom                 String    @db.VarChar(255)
  type                String?   @db.VarChar(100)
  taille              Int?
  hash                String?   @db.VarChar(128)
  version             Int       @default(1)
  date_upload         DateTime  @default(now()) @db.Timestamptz(6)
  contenu             Bytes
  telecharge          Boolean   @default(false)
  date_telechargement DateTime? @db.Timestamptz(6)

  demande     Demande?     @relation(fields: [id_demande], references: [id_demande], onDelete: Cascade)
  reclamation Reclamation? @relation(fields: [id_reclamation], references: [id_reclamation], onDelete: Cascade)
  message     Message?     @relation(fields: [id_message], references: [id_message], onDelete: Cascade)

  @@index([id_demande], map: "idx_document_demande")
  @@index([id_reclamation], map: "idx_document_reclamation")
  @@index([id_message], map: "idx_document_id_message")
  @@map("document")
}

model DocumentOfficiel {
  id_document_officiel   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_demande             String?   @db.Uuid
  id_etudiant            String    @db.Uuid
  nom                    String    @db.VarChar(255)
  type                   String?   @db.VarChar(100)
  categorie              String?   @db.VarChar(50)
  contenu                Bytes
  taille                 Int
  hash                   String?   @db.VarChar(128)
  date_generation        DateTime  @default(now()) @db.Timestamptz(6)
  date_expiration        DateTime? @db.Date
  nombre_telechargements Int       @default(0)
  dernier_telechargement DateTime? @db.Timestamptz(6)

  demande  Demande? @relation(fields: [id_demande], references: [id_demande], onDelete: SetNull)
  etudiant Etudiant @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)

  @@index([id_demande], map: "idx_doc_officiel_demande")
  @@index([id_etudiant], map: "idx_doc_officiel_etudiant")
  @@map("document_officiel")
}

model CertificatMedical {
  id_certificat  String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_etudiant    String                 @db.Uuid
  id_valide_par  String?                @db.Uuid
  date_depot     DateTime               @default(now()) @db.Timestamptz(6)
  date_debut     DateTime               @db.Date
  date_fin       DateTime               @db.Date
  motif          String?                @db.Text
  statut         enum_statut_certificat @default(En_Attente)
  fichier        Bytes
  fichier_nom    String?                @db.VarChar(255)
  fichier_type   String?                @db.VarChar(100)
  fichier_taille Int?

  etudiant     Etudiant        @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)
  valide_par   ScolariteStaff? @relation(fields: [id_valide_par], references: [id_scolarite], onDelete: SetNull)
  reclamations Reclamation[]

  @@index([id_etudiant], map: "idx_certificat_etudiant")
  @@map("certificat_medical")
}

model VerificationExam {
  id_verification       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_etudiant           String                   @db.Uuid
  id_professeur         String                   @db.Uuid
  id_transmis_par       String?                  @db.Uuid
  date_demande          DateTime                 @default(now()) @db.Timestamptz(6)
  motif                 String?                  @db.Text
  statut                enum_statut_verification @default(Demandee)
  date_planification    DateTime?                @db.Date
  heure_planification   DateTime?                @db.Time(6)
  salle_planification   String?                  @db.VarChar(50)
  commentaires_prof     String?                  @db.Text
  commentaires_etudiant String?                  @db.Text

  etudiant     Etudiant        @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)
  professeur   Professeur      @relation(fields: [id_professeur], references: [id_professeur], onDelete: Cascade)
  transmis_par ScolariteStaff? @relation(fields: [id_transmis_par], references: [id_scolarite], onDelete: SetNull)

  @@index([id_etudiant], map: "idx_verif_examen_etudiant")
  @@index([id_professeur], map: "idx_verif_examen_professeur")
  @@map("verification_examen")
}


// SALLES, SESSIONS, CALENDRIER (✅ 100% SÉCURISÉ)


model Salle {
  id_salle     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero       String            @unique @db.VarChar(30)
  nom          String?           @db.VarChar(150)
  capacite     Int               @db.SmallInt
  type         enum_type_salle
  equipements  Json?             @db.JsonB
  localisation String?           @db.VarChar(255)
  statut       enum_statut_salle @default(Disponible)

  sessions     SessionSalle[]
  reservations ReservationSalle[]
  alertes      AlerteIa[]

  @@map("salle")
}

model SessionSalle {
  id_session         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_salle           String              @db.Uuid
  id_cours           String              @db.Uuid
  id_professeur      String              @db.Uuid
  date               DateTime            @db.Date
  heure_debut        DateTime            @db.Time(6)
  heure_fin          DateTime            @db.Time(6)
  heure_debut_reelle DateTime?           @db.Time(6)
  heure_fin_reelle   DateTime?           @db.Time(6)
  statut             enum_statut_session @default(Planifiee)
  nombre_etudiants   Int?
  retard_moyen       Int?
  
  // ✅ COLONNES EXISTANTES + NOUVELLES (Aucune donnée ne sera perdue)
  id_filiere         String?             @db.Uuid
  id_calendrier      String?             @db.Uuid
  semestre           String?             @db.VarChar(50)

  salle                Salle                @relation(fields: [id_salle], references: [id_salle], onDelete: Cascade)
  cours                Cours                @relation(fields: [id_cours], references: [id_cours], onDelete: Cascade)
  professeur           Professeur           @relation(fields: [id_professeur], references: [id_professeur], onDelete: Restrict)
  filiere              Filiere?             @relation(fields: [id_filiere], references: [id_filiere], onDelete: SetNull)
  presences            PresenceEtudiant[]
  calendrier           CalendrierAcademique? @relation(fields: [id_calendrier], references: [id_calendrier], onDelete: SetNull)

  @@index([id_salle], map: "idx_session_salle_salle")
  @@index([id_cours], map: "idx_session_salle_cours")
  @@index([id_professeur], map: "idx_session_salle_professeur")
  @@index([date], map: "idx_session_salle_date")
  @@map("session_salle")
}

model CalendrierAcademique {
  id_calendrier  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom            String   @db.VarChar(150)
  annee_scolaire String   @unique @db.VarChar(20)
  date_debut     DateTime @db.Date
  date_fin       DateTime @db.Date
  periodes       Json?    @db.JsonB

  sessions       SessionSalle[]

  @@map("calendrier_academique")
}

model PresenceEtudiant {
  id_presence            String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_session             String                       @db.Uuid
  id_etudiant            String                       @db.Uuid
  heure_arrivee          DateTime?                    @db.Time(6)
  heure_depart           DateTime?                    @db.Time(6)
  statut                 enum_statut_presence         @default(Absent)
  methode_identification enum_methode_identification?

  session  SessionSalle @relation(fields: [id_session], references: [id_session], onDelete: Cascade)
  etudiant Etudiant     @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)

  @@unique([id_session, id_etudiant])
  @@index([id_session], map: "idx_presence_session")
  @@index([id_etudiant], map: "idx_presence_etudiant")
  @@map("presence_etudiant")
}

model ReservationSalle {
  id_reservation String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_salle       String                  @db.Uuid
  id_demandeur   String                  @db.Uuid
  date           DateTime                @db.Date
  heure_debut    DateTime                @db.Time(6)
  heure_fin      DateTime                @db.Time(6)
  motif          String?                 @db.VarChar(255)
  statut         enum_statut_reservation @default(Demandee)

  salle     Salle       @relation(fields: [id_salle], references: [id_salle], onDelete: Cascade)
  demandeur Utilisateur @relation(fields: [id_demandeur], references: [id_utilisateur], onDelete: Cascade)

  @@index([id_salle], map: "idx_reservation_salle_salle")
  @@index([id_demandeur], map: "idx_reservation_salle_demandeur")
  @@map("reservation_salle")
}

model AlerteIa {
  id_alerte      String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_salle       String?            @db.Uuid
  type           enum_type_alerte
  description    String?            @db.Text
  date_detection DateTime           @default(now()) @db.Timestamptz(6)
  statut         enum_statut_alerte @default(Nouvelle)
  priorite       enum_priorite      @default(Normale)

  salle Salle? @relation(fields: [id_salle], references: [id_salle], onDelete: SetNull)

  @@index([id_salle], map: "idx_alerte_ia_salle")
  @@index([statut], map: "idx_alerte_ia_statut")
  @@map("alerte_ia")
}


// RH, CLUBS, MESSAGERIE & IA


model DemandeRh {
  id_demande_rh   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_employe      String               @db.Uuid
  id_traite_par   String?              @db.Uuid
  type            enum_type_demande_rh
  statut          enum_statut_demande  @default(Soumise)
  date_demande    DateTime             @default(now()) @db.Timestamptz(6)
  date_debut      DateTime?            @db.Date
  date_fin        DateTime?            @db.Date
  duree           Int?
  motif           String?              @db.Text
  justificatif    String?              @db.VarChar(500)
  commentaires_rh String?              @db.Text

  employe    Employe        @relation(fields: [id_employe], references: [id_employe], onDelete: Cascade)
  traite_par RhResponsable? @relation(fields: [id_traite_par], references: [id_rh], onDelete: SetNull)

  @@index([id_employe], map: "idx_demande_rh_employe")
  @@index([id_traite_par], map: "idx_demande_rh_traite_par")
  @@map("demande_rh")
}

model Club {
  id_club       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom           String           @unique @db.VarChar(150)
  description   String?          @db.Text
  date_creation DateTime         @default(now()) @db.Date
  statut        enum_statut_club @default(Actif)
  budget        Decimal          @default(0) @db.Decimal(12, 2)

  president PresidentClub?
  demandes  DemandeClub[]

  @@map("club")
}

model PresidentClub {
  id_president     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_club          String                @unique @db.Uuid
  id_etudiant      String                @db.Uuid
  id_designe_par   String?               @db.Uuid
  date_designation DateTime              @default(now()) @db.Date
  date_fin_mandat  DateTime?             @db.Date
  statut           enum_statut_president @default(Actif)

  club          Club            @relation(fields: [id_club], references: [id_club], onDelete: Cascade)
  etudiant      Etudiant        @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)
  designe_par   ScolariteStaff? @relation(fields: [id_designe_par], references: [id_scolarite], onDelete: SetNull)
  demandes_club DemandeClub[]

  @@index([id_etudiant], map: "idx_president_club_etudiant")
  @@map("president_club")
}

model DemandeClub {
  id_demande_club String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_club         String                   @db.Uuid
  id_president    String                   @db.Uuid
  id_traite_par   String?                  @db.Uuid
  type            enum_type_demande_club
  objet           String                   @db.VarChar(255)
  description     String?                  @db.Text
  date_demande    DateTime                 @default(now()) @db.Timestamptz(6)
  statut          enum_statut_demande_club @default(Soumise)
  date_evenement  DateTime?                @db.Date
  heure_debut     DateTime?                @db.Time(6)
  heure_fin       DateTime?                @db.Time(6)
  budget_demande  Decimal?                 @db.Decimal(12, 2)
  justificatifs   Json?                    @db.JsonB

  club       Club            @relation(fields: [id_club], references: [id_club], onDelete: Cascade)
  president  PresidentClub   @relation(fields: [id_president], references: [id_president], onDelete: Cascade)
  traite_par ScolariteStaff? @relation(fields: [id_traite_par], references: [id_scolarite], onDelete: SetNull)

  @@index([id_club], map: "idx_demande_club_club")
  @@index([id_president], map: "idx_demande_club_president")
  @@map("demande_club")
}

model Conversation {
  id_conversation String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_etudiant     String?                  @db.Uuid
  sujet           String?                  @db.VarChar(255)
  date_creation   DateTime                 @default(now()) @db.Timestamptz(6)
  statut          enum_statut_conversation @default(Ouverte)

  etudiant     Etudiant?                 @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([id_etudiant], map: "idx_conversation_etudiant")
  @@map("conversation")
}

model ConversationParticipant {
  id_conversation String   @db.Uuid
  id_utilisateur  String   @db.Uuid
  date_ajout      DateTime @default(now()) @db.Timestamptz(6)

  conversation Conversation @relation(fields: [id_conversation], references: [id_conversation], onDelete: Cascade)
  utilisateur  Utilisateur  @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)

  @@id([id_conversation, id_utilisateur])
  @@map("conversation_participant")
}

model Message {
  id_message      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_conversation String   @db.Uuid
  id_expediteur   String   @db.Uuid
  contenu         String   @db.Text
  date_envoi      DateTime @default(now()) @db.Timestamptz(6)
  lu              Boolean  @default(false)
  pieces_jointes  Json?    @db.JsonB

  conversation Conversation @relation(fields: [id_conversation], references: [id_conversation], onDelete: Cascade)
  expediteur   Utilisateur  @relation(fields: [id_expediteur], references: [id_utilisateur], onDelete: Cascade)
  documents    Document[]

  @@index([id_conversation], map: "idx_message_conversation")
  @@index([id_expediteur], map: "idx_message_expediteur")
  @@map("message")
}

model Notification {
  id_notification String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_utilisateur  String                     @db.Uuid
  titre           String                     @db.VarChar(255)
  message         String                     @db.Text
  type            enum_type_notification
  date_envoi      DateTime                   @default(now()) @db.Timestamptz(6)
  lu              Boolean                    @default(false)
  priorite        enum_priorite_notification @default(Info)

  utilisateur Utilisateur @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: Cascade)

  @@index([id_utilisateur], map: "idx_notification_utilisateur")
  @@index([lu], map: "idx_notification_lu")
  @@map("notification")
}

model BaseConnaissance {
  id_base       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titre         String                   @db.VarChar(255)
  contenu       String                   @db.Text
  categorie     String?                  @db.VarChar(100)
  date_maj      DateTime                 @default(now()) @db.Timestamptz(6)
  vecteur       Json?                    @db.JsonB
  search_vector Unsupported("tsvector")?
  mots_cles     String?                  @db.Text

  messages_ia MessageIA[]

  @@index([search_vector], map: "idx_base_connaissance_search")
  @@map("base_connaissance")
}

model ConversationIA {
  id_conversation_ia String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_etudiant        String                      @db.Uuid
  date_creation      DateTime                    @default(now()) @db.Timestamptz(6)
  statut             enum_statut_conversation_ia @default(Active)
  satisfaction       Int?                        @db.SmallInt

  etudiant    Etudiant    @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade)
  messages_ia MessageIA[]

  @@index([id_etudiant], map: "idx_conversation_ia_etudiant")
  @@map("conversation_ia")
}

model MessageIA {
  id_message_ia      String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_conversation_ia String               @db.Uuid
  id_base            String?              @db.Uuid
  role               enum_role_message_ia
  contenu            String               @db.Text
  date_envoi         DateTime             @default(now()) @db.Timestamptz(6)
  tokens             Int?
  metadata           Json?                @db.JsonB

  conversation_ia   ConversationIA    @relation(fields: [id_conversation_ia], references: [id_conversation_ia], onDelete: Cascade)
  base_connaissance BaseConnaissance? @relation(fields: [id_base], references: [id_base], onDelete: SetNull)

  @@index([id_conversation_ia], map: "idx_message_ia_conversation")
  @@index([id_base], map: "idx_message_ia_base")
  @@map("message_ia")
}

model AuditLog {
  id_log         BigInt   @id @default(autoincrement())
  id_utilisateur String?  @db.Uuid
  action         String   @db.VarChar(100)
  module         String   @db.VarChar(100)
  entite         String   @db.VarChar(100)
  entite_id      String?  @db.Uuid
  date_action    DateTime @default(now()) @db.Timestamptz(6)
  adresse_ip     String?  @db.Inet
  user_agent     String?  @db.VarChar(500)
  donnees_avant  Json?    @db.JsonB
  donnees_apres  Json?    @db.JsonB

  utilisateur Utilisateur? @relation(fields: [id_utilisateur], references: [id_utilisateur], onDelete: SetNull)

  @@index([id_utilisateur], map: "idx_audit_log_utilisateur")
  @@index([entite, entite_id], map: "idx_audit_log_entite")
  @@index([date_action], map: "idx_audit_log_date")
  @@map("audit_log")
}

model ParametreSysteme {
  id_parametre String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cle          String              @unique @db.VarChar(150)
  valeur       String?             @db.Text
  type         enum_type_parametre @default(String)
  description  String?             @db.Text
  module       String?             @db.VarChar(100)

  @@map("parametre_systeme")
}