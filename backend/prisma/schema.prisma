/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model salle {
  id_salle          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numero            String              @unique @db.VarChar(30)
  nom               String?             @db.VarChar(150)
  capacite          Int                 @db.SmallInt
  type              enum_type_salle
  equipements       Json?
  localisation      String?             @db.VarChar(255)
  statut            enum_statut_salle   @default(Disponible)
  alerte_ia         alerte_ia[]
  reservation_salle reservation_salle[]
  session_salle     session_salle[]
}

model scolarite_staff {
  id_scolarite        String                @id @db.Uuid
  service             String?               @db.VarChar(150)
  poste               String?               @db.VarChar(150)
  bureau              String?               @db.VarChar(50)
  certificat_medical  certificat_medical[]
  demande             demande[]
  demande_club        demande_club[]
  president_club      president_club[]
  reclamation         reclamation[]
  employe             employe               @relation(fields: [id_scolarite], references: [id_employe], onDelete: Cascade, onUpdate: NoAction)
  verification_examen verification_examen[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model session_salle {
  id_session         String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_salle           String              @db.Uuid
  id_cours           String              @db.Uuid
  id_professeur      String              @db.Uuid
  date               DateTime            @db.Date
  heure_debut        DateTime            @db.Time(6)
  heure_fin          DateTime            @db.Time(6)
  heure_debut_reelle DateTime?           @db.Time(6)
  heure_fin_reelle   DateTime?           @db.Time(6)
  statut             enum_statut_session @default(Planifiee)
  nombre_etudiants   Int?
  retard_moyen       Int?
  presence_etudiant  presence_etudiant[]
  cours              cours               @relation(fields: [id_cours], references: [id_cours], onDelete: Cascade, onUpdate: NoAction)
  professeur         professeur          @relation(fields: [id_professeur], references: [id_professeur], onUpdate: NoAction)
  salle              salle               @relation(fields: [id_salle], references: [id_salle], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_cours], map: "idx_session_salle_cours")
  @@index([date], map: "idx_session_salle_date")
  @@index([id_professeur], map: "idx_session_salle_professeur")
  @@index([id_salle], map: "idx_session_salle_salle")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model type_demande {
  id_type          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libelle          String    @db.VarChar(150)
  code             String    @unique @db.VarChar(30)
  description      String?
  id_workflow      String?   @db.Uuid
  delai_traitement Int?
  pieces_requises  Json?
  demande          demande[]
  workflow         workflow? @relation(fields: [id_workflow], references: [id_workflow], onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model type_reclamation {
  id_type                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  libelle                String                     @db.VarChar(150)
  code                   String                     @unique @db.VarChar(30)
  categorie              enum_categorie_reclamation
  delai_limite           Int?
  quota_max              Int?
  conditions_eligibilite Json?
  reclamation            reclamation[]
}

model utilisateur {
  id_utilisateur           String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_role                  String                     @db.Uuid
  nom                      String                     @db.VarChar(100)
  prenom                   String                     @db.VarChar(100)
  email                    String                     @unique @db.VarChar(255)
  mot_de_passe             String                     @db.VarChar(255)
  telephone                String?                    @db.VarChar(30)
  photo                    String?                    @db.VarChar(500)
  actif                    Boolean                    @default(true)
  date_creation            DateTime                   @default(now()) @db.Timestamptz(6)
  derniere_connexion       DateTime?                  @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  audit_log                audit_log[]
  conversation_participant conversation_participant[]
  employe                  employe?
  etudiant                 etudiant?
  message                  message[]
  notification             notification[]
  reservation_salle        reservation_salle[]
  role                     role                       @relation(fields: [id_role], references: [id_role], onUpdate: NoAction)

  @@index([id_role], map: "idx_utilisateur_role")
}

model verification_examen {
  id_verification       String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  id_etudiant           String                   @db.Uuid
  id_professeur         String                   @db.Uuid
  id_transmis_par       String?                  @db.Uuid
  date_demande          DateTime                 @default(now()) @db.Timestamptz(6)
  motif                 String?
  statut                enum_statut_verification @default(Demandee)
  date_planification    DateTime?                @db.Date
  heure_planification   DateTime?                @db.Time(6)
  salle_planification   String?                  @db.VarChar(50)
  commentaires_prof     String?
  commentaires_etudiant String?
  etudiant              etudiant                 @relation(fields: [id_etudiant], references: [id_etudiant], onDelete: Cascade, onUpdate: NoAction)
  professeur            professeur               @relation(fields: [id_professeur], references: [id_professeur], onDelete: Cascade, onUpdate: NoAction)
  scolarite_staff       scolarite_staff?         @relation(fields: [id_transmis_par], references: [id_scolarite], onUpdate: NoAction)

  @@index([id_etudiant], map: "idx_verif_examen_etudiant")
  @@index([id_professeur], map: "idx_verif_examen_professeur")
}

model workflow {
  id_workflow    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nom            String               @db.VarChar(150)
  description    String?
  statut         enum_statut_workflow @default(Actif)
  date_creation  DateTime             @default(now()) @db.Timestamptz(6)
  demande        demande[]
  etape_workflow etape_workflow[]
  type_demande   type_demande[]
}

